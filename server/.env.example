# ─────────────────────────────────────────────────────────────
#  Copy this file to server/.env and fill in the values.
#  Anything left blank falls back to MOCK mode so the app still runs.
#  See docs/PAYMENT_INTEGRATION.md for where to get each value.
# ─────────────────────────────────────────────────────────────

PORT=5000
# Public URL of the storefront (used for payment return URLs)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for webhook / notify URLs). Must be HTTPS in production.
SERVER_URL=http://localhost:5000
# Secret header value for /api/admin/* (send as x-admin-token)
ADMIN_TOKEN=change-me-admin-token

# ── Seller / GST details (printed on invoices) ──────────────
SELLER_NAME=Techno Service Pvt Ltd
SELLER_GSTIN=27ABCDE1234F1Z5
# Two-digit GST state code + name of the seller's registered state
SELLER_STATE_CODE=27
SELLER_STATE=Maharashtra
SELLER_ADDRESS=Office 101, Example Tower, Pune 411001
SELLER_EMAIL=billing@example.com
SELLER_PHONE=+91-9000000000
# Invoice number prefix; final format: INV/2026-27/00001
INVOICE_PREFIX=INV

# ── Payment methods to show at checkout (comma separated) ───
# Options: razorpay, cashfree, upi_direct, cod, mock
PAYMENT_METHODS=razorpay,cashfree,upi_direct,cod

# ── Razorpay (UPI, cards, wallets, netbanking, EMI) ─────────
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → secret you set there
RAZORPAY_WEBHOOK_SECRET=

# ── Cashfree Payments (UPI, cards, wallets, netbanking, Pay Later) ─
# Merchant Dashboard → Developers → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox

# ── Direct UPI (your own VPA, zero gateway fee, manual UTR check) ─
# Business VPA from your bank / PSP app (e.g. yourshop@okicici)
UPI_VPA=
# Payee name exactly as registered with the bank
UPI_PAYEE_NAME=Techno Service

# ── Cash on Delivery ────────────────────────────────────────
COD_MAX_ORDER_RUPEES=5000
COD_FEE_RUPEES=40

# ── Shipping / Courier (Shiprocket aggregator) ──────────────
# Create an API user: Shiprocket → Settings → API → Add New API User
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact "Pickup Location" nickname from Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=411001
# true = create shipment automatically as soon as payment is confirmed
SHIPROCKET_AUTO_CREATE=false
FREE_SHIPPING_ABOVE_RUPEES=999
FLAT_SHIPPING_RUPEES=49

# ── Inventory sync with billing software ────────────────────
# Pull: GET this URL, expects JSON [{ "sku": "...", "stock": 12 }]
INVENTORY_PULL_URL=
INVENTORY_PULL_TOKEN=
# Minutes between automatic pulls (0 = disabled)
INVENTORY_PULL_INTERVAL_MIN=15
# Push: shared secret your billing software uses to sign POST /api/inventory/webhook
INVENTORY_WEBHOOK_SECRET=
# Sale push: we POST every paid order here so billing software can book the sale
BILLING_SALE_WEBHOOK_URL=
BILLING_SALE_WEBHOOK_TOKEN=
